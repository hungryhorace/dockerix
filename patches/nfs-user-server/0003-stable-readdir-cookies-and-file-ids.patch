diff --git a/efsdir.c b/efsdir.c
new file mode 100644
index 0000000..27fbe27
--- /dev/null
+++ b/efsdir.c
@@ -0,0 +1,241 @@
+/*
+ * efsdir.c	Directory streams with dependable positions.
+ *
+ * The server used to hand telldir() positions to clients as READDIR
+ * cookies and seekdir() back to them on the next call, on a freshly
+ * opened stream. Neither holds on a modern host: ext4 and overlayfs give
+ * 64-bit hash positions that a 32-bit NFSv2 cookie truncates, and a
+ * FUSE/virtiofs mount (a Docker Desktop bind mount) ignores the seek and
+ * starts again at the first entry, so a client asking for the rest of a
+ * directory gets the start of it again, for ever. fh_buildpath() walks
+ * directories the same way, and loops for ever on such a mount when it
+ * has to backtrack.
+ *
+ * An EFS_DIR is instead the whole directory read into memory when it is
+ * opened, "." and ".." first (as a client expects a listing to begin),
+ * and a position is simply the number of entries read so far. Those
+ * positions are small, fit any cookie, and mean the same thing to every
+ * stream on the same directory contents.
+ */
+
+#include "nfsd.h"
+
+struct efs_dirent {
+	ino_t		ino;
+	char *		name;
+};
+
+struct efs_dir {
+	struct efs_dirent *	ents;
+	long			count;
+	long			pos;
+	struct dirent		cur;	/* what efs_readdir() returns */
+};
+
+static int
+is_dot(const char *name)
+{
+	return name[0] == '.' && name[1] == '\0';
+}
+
+static int
+is_dotdot(const char *name)
+{
+	return name[0] == '.' && name[1] == '.' && name[2] == '\0';
+}
+
+/* Sort rank: "." first, ".." second, the rest in directory order. */
+static int
+rank(const char *name)
+{
+	return is_dot(name) ? 0 : is_dotdot(name) ? 1 : 2;
+}
+
+void
+efs_closedir(EFS_DIR *d)
+{
+	long	i;
+
+	if (d == NULL)
+		return;
+	for (i = 0; i < d->count; i++)
+		free(d->ents[i].name);
+	free(d->ents);
+	free(d);
+}
+
+EFS_DIR *
+efs_opendir(const char *path)
+{
+	DIR		*dir;
+	struct dirent	*dp;
+	EFS_DIR		*d;
+	long		cap = 0, i, j;
+	int		err;
+
+	if ((dir = opendir(path)) == NULL)
+		return NULL;
+	if ((d = calloc(1, sizeof(*d))) == NULL) {
+		closedir(dir);
+		errno = ENOMEM;
+		return NULL;
+	}
+	for (;;) {
+		errno = 0;
+		if ((dp = readdir(dir)) == NULL)
+			break;
+		if (d->count == cap) {
+			struct efs_dirent *n;
+
+			cap = cap ? 2 * cap : 64;
+			n = realloc(d->ents, cap * sizeof(*n));
+			if (n == NULL) {
+				errno = ENOMEM;
+				break;
+			}
+			d->ents = n;
+		}
+		d->ents[d->count].ino = dp->d_ino;
+		if ((d->ents[d->count].name = strdup(dp->d_name)) == NULL) {
+			errno = ENOMEM;
+			break;
+		}
+		d->count++;
+	}
+	err = errno;
+	closedir(dir);
+	if (err != 0) {
+		efs_closedir(d);
+		errno = err;
+		return NULL;
+	}
+
+	/* Stable insertion of "." and ".." at the front. */
+	for (i = 1; i < d->count; i++) {
+		struct efs_dirent e = d->ents[i];
+		int r = rank(e.name);
+
+		if (r == 2)
+			continue;
+		for (j = i; j > 0 && rank(d->ents[j - 1].name) > r; j--)
+			d->ents[j] = d->ents[j - 1];
+		d->ents[j] = e;
+	}
+	return d;
+}
+
+struct dirent *
+efs_readdir(EFS_DIR *d)
+{
+	struct efs_dirent *e;
+
+	if (d->pos >= d->count)
+		return NULL;
+	e = &d->ents[d->pos++];
+	memset(&d->cur, 0, sizeof(d->cur));
+	d->cur.d_ino = e->ino;
+	strncpy(d->cur.d_name, e->name, sizeof(d->cur.d_name) - 1);
+	return &d->cur;
+}
+
+long
+efs_telldir(EFS_DIR *d)
+{
+	return d->pos;
+}
+
+void
+efs_seekdir(EFS_DIR *d, long pos)
+{
+	d->pos = (pos < 0) ? 0 : (pos > d->count) ? d->count : pos;
+}
+
+/*
+ * The inode numbers directories list for their entries, which path_psi()
+ * (fh.c) uses as a file's identity. A request may ask about the same
+ * directory several times, so its listings are kept for the rest of that
+ * request (efs_request_begin() starts each one), and no longer: a
+ * directory's times cannot say when a listing has gone out of date,
+ * since a Docker Desktop bind mount never updates the container's view
+ * of a directory's times for changes made on the Mac. A process without
+ * requests (mountd) reads every listing afresh.
+ */
+#define INO_CACHE	8
+
+static struct inosnap {
+	char *		path;
+	dev_t		dev;
+	unsigned long	gen;
+	EFS_DIR *	dir;
+	unsigned long	used;
+} ino_cache[INO_CACHE];
+static unsigned long	ino_clock;
+static unsigned long	ino_gen;
+
+void
+efs_request_begin(void)
+{
+	if (++ino_gen == 0)
+		ino_gen = 1;
+}
+
+static int
+find_name(EFS_DIR *d, const char *name, ino_t *ino)
+{
+	long	i;
+
+	for (i = 0; i < d->count; i++) {
+		if (strcmp(d->ents[i].name, name) == 0) {
+			*ino = d->ents[i].ino;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int
+efs_dirent_ino(const char *dir, const struct stat *dirst,
+		const char *name, ino_t *ino)
+{
+	struct inosnap	*s, *slot = NULL;
+	EFS_DIR		*d;
+	char		*path;
+	int		i;
+
+	for (i = 0; i < INO_CACHE; i++) {
+		s = &ino_cache[i];
+		if (s->path != NULL && strcmp(s->path, dir) == 0) {
+			slot = s;
+			break;
+		}
+		if (slot == NULL || (slot->path != NULL
+		 && (s->path == NULL || s->used < slot->used)))
+			slot = s;
+	}
+	if (slot->path != NULL && strcmp(slot->path, dir) == 0
+	 && slot->dev == dirst->st_dev
+	 && ino_gen != 0 && slot->gen == ino_gen) {
+		slot->used = ++ino_clock;
+		if (find_name(slot->dir, name, ino))
+			return 0;
+	}
+
+	if ((d = efs_opendir(dir)) == NULL)
+		return -1;
+	if ((path = strdup(dir)) == NULL) {
+		efs_closedir(d);
+		errno = ENOMEM;
+		return -1;
+	}
+	free(slot->path);
+	efs_closedir(slot->dir);
+	slot->path = path;
+	slot->dev = dirst->st_dev;
+	slot->gen = ino_gen;
+	slot->dir = d;
+	slot->used = ++ino_clock;
+	if (find_name(d, name, ino))
+		return 0;
+	errno = ENOENT;
+	return -1;
+}
