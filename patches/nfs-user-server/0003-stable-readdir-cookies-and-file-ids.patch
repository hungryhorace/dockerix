+/*
+ * A READDIR cookie is the number of entries the client has had so far
+ * (efsdir.c), so the rest of a listing must come from the directory as it
+ * was when the listing began: count positions in a directory that has
+ * since lost entries and the client misses as many, which leaves `rm -r`
+ * unable to empty it. Each listing (a READDIR at cookie 0) therefore
+ * takes a snapshot of the directory, and the calls that continue it read
+ * the same snapshot. Snapshots are kept per directory, the least
+ * recently used given up first; a continuation whose snapshot has gone
+ * reads a fresh one from its position, as best it can.
+ */
+#define RD_CACHE	64
+
+static struct rdsnap {
+	char		*path;
+	EFS_DIR		*dir;
+	unsigned long	used;
+} rd_cache[RD_CACHE];
+static unsigned long	rd_clock;
+
+static EFS_DIR *
+readdir_snapshot(const char *path, long cookie)
+{
+	struct rdsnap	*s, *slot = NULL;
+	int		i;
+
+	for (i = 0; i < RD_CACHE; i++) {
+		s = &rd_cache[i];
+		if (s->dir != NULL && strcmp(s->path, path) == 0) {
+			slot = s;
+			if (cookie != 0) {
+				s->used = ++rd_clock;
+				return s->dir;
+			}
+			break;
+		}
+		if (slot == NULL || (slot->dir != NULL
+		 && (s->dir == NULL || s->used < slot->used)))
+			slot = s;
+	}
+	efs_closedir(slot->dir);
+	free(slot->path);
+	slot->path = NULL;
+	if ((slot->dir = efs_opendir(path)) == NULL)
+		return NULL;
+	slot->path = xstrdup(path);
+	slot->used = ++rd_clock;
+	return slot->dir;
+}
+
+/* The pseudo inode of the directory above DIR, as LOOKUP of ".." gives it. */
+static psi_t
+parent_psi(const char *dir)
+{
+	char	parent[NFS_MAXPATHLEN + 1], *slash;
+	nfs_fh	fh;
+
+	if (strlen(dir) > NFS_MAXPATHLEN)
+		return 0;
+	strcpy(parent, dir);
+	if ((slash = strrchr(parent, '/')) == NULL)
+		return 0;
+	if (slash == parent)
+		slash++;
+	*slash = '\0';
+	if (fh_create(&fh, parent) != NFS_OK)
+		return 0;
+	return fh_psi(&fh);
+}
