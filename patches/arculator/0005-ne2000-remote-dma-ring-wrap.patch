+//
+// Step the remote DMA address, wrapping from the end of the receive ring
+// to its start as the 8390 does. PSTOP may be 0x100 (a ring reaching the
+// top of the 64K), so the end of the ring is 0x10000: do the arithmetic
+// wider than the 16-bit address register, or the address rolls over to 0
+// instead of wrapping to PSTART, and a frame that crosses the end of the
+// ring is read back with its tail taken from the bottom of memory.
+//
+static void ne2000_dma_advance(ne2000_t *ne2000, int io_len)
+{
+	uint32_t next = (uint32_t)ne2000->remote_dma + io_len;
+
+	if (next == (uint32_t)ne2000->page_stop << 8)
+		next = (uint32_t)ne2000->page_start << 8;
+	ne2000->remote_dma = (uint16_t)next;
+}
+
